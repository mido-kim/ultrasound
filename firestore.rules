rules_version = '2';

// The whole rule set for this app's Firebase project (ultrasound-ebd93). Paste
// ALL of it into Firebase console → Firestore Database → Rules and Publish:
// exactly two accounts share the bring-up records, and nothing else is allowed.
//
// Replace the two UIDs with the ones each person sees in this app under
// 설정 → 동기화 after signing in (or Firebase console → Authentication → Users).
service cloud.firestore {
  match /databases/{database}/documents {
    match /bringup/{project}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid in ['MIDO_UID', 'JEONGIN_UID'];
    }
  }
}
